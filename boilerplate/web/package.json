{
  "name": "monorepo",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@10.29.3",
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@types/node": "^22.19.15",
    "dependency-cruiser": "^17.3.8",
    "oxfmt": "^0.36.0",
    "oxlint": "^1.51.0",
    "oxlint-tsgolint": "^0.16.0",
    "typescript": "^5.0.0",
    "vite": "^5.4.21",
    "vite-plugin-dts": "^4.5.4",
    "vite-plus": "^0.1.13",
    "vitest": "^3.0.8"
  },
  "scripts": {
    "format": "oxfmt",
    "format:check": "oxfmt --check",
